# Absolute or project-relative path to the SQLite database file.
DATABASE_URL=./data/vista-kigali.db

# Public origin used in password reset links.
APP_URL=http://localhost:3000

# When true, password reset links are shown in the UI instead of being emailed.
# Enable only for local development / staging without a mail provider.
AUTH_EXPOSE_RESET_LINKS=false

# Password reset link lifetime in minutes.
AUTH_RESET_TOKEN_TTL_MINUTES=30
