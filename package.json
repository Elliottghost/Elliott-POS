{
  "name": "vista-kigali-management",
  "version": "0.1.0",
  "private": true,
  "description": "Vista Kigali Bar - Resto & Accommodation management platform — foundation phase",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env --import tsx scripts/migrate.ts",
    "db:seed": "node --env-file=.env --import tsx src/db/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.6",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.12",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "4.148.0"
  }
}
